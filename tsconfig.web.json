{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo"
  },
  "include": ["src/renderer/**/*", "src/shared/**/*"],
  // Runs under Node against the main process (see tsconfig.node.json).
  "exclude": ["src/renderer/**/*.integration.test.ts"]
}
